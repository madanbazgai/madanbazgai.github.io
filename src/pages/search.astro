---
import Base from "../layouts/Base.astro";
---

<Base title="Search" noindex list>
  <h1 class="sr-only">Search</h1>
  <div id="searchbox">
    <input id="searchInput" autofocus placeholder="Search any posts" aria-label="search" type="search" autocomplete="off" />
    <ul id="searchResults" aria-label="search results" aria-live="polite"></ul>
  </div>
</Base>

<script>
  type Item = { title: string; url: string; text: string };

  const input = document.getElementById("searchInput") as HTMLInputElement;
  const results = document.getElementById("searchResults")!;
  const items: Item[] = await (await fetch("/index.json")).json();

  // Every word of the query must appear in the post; title matches come first.
  const find = (query: string) => {
    const words = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (!words.length) return [];
    const has = (s: string) => words.every((w) => s.toLowerCase().includes(w));
    return items.filter((i) => has(`${i.title} ${i.text}`)).sort((a, b) => +has(b.title) - +has(a.title));
  };

  const search = () => {
    results.replaceChildren(
      ...find(input.value).map((item) => {
        const li = Object.assign(document.createElement("li"), { className: "post-entry" });
        const header = Object.assign(document.createElement("header"), {
          className: "entry-header",
          textContent: `${item.title} »`,
        });
        const link = Object.assign(document.createElement("a"), { href: item.url, ariaLabel: item.title });
        li.append(header, link);
        return li;
      }),
    );
  };

  input.addEventListener("input", search);

  // Keyboard: arrows move between the input and results, Escape clears.
  document.addEventListener("keydown", (event) => {
    const targets: HTMLElement[] = [input, ...results.querySelectorAll("a")];
    const current = targets.indexOf(document.activeElement as HTMLElement);
    if (event.key === "Escape") {
      input.value = "";
      search();
      input.focus();
    } else if (current >= 0 && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
      event.preventDefault();
      const step = event.key === "ArrowDown" ? 1 : -1;
      const target = targets[Math.min(Math.max(current + step, 0), targets.length - 1)];
      target.focus();
      results.querySelector(".focus")?.classList.remove("focus");
      if (target !== input) target.parentElement!.classList.add("focus");
    }
  });
</script>

<style>
  input {
    width: 100%;
    padding: 4px 10px;
    color: var(--primary);
    font-weight: bold;
    border: 2px solid var(--tertiary);
    border-radius: var(--radius);

    &:focus {
      border-color: var(--secondary);
    }
  }

  #searchResults {
    width: 100%;
    margin: 10px 0;
  }

  /* Result items are created by the script, so they need :global() */
  #searchResults :global(li) {
    position: relative;
    display: flex;
    margin: 10px 0;
    padding: 10px;
    list-style: none;
    font-weight: 500;
    background: var(--entry);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.1s;
  }

  #searchResults :global(li:active),
  #searchResults :global(.focus) {
    transform: scale(0.98);
  }

  #searchResults :global(.focus) {
    border: 2px solid var(--tertiary);
  }

  #searchResults :global(a) {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion) {
    #searchResults :global(li:active),
    #searchResults :global(.focus) {
      transform: none;
    }
  }
</style>
