---
import Base from "../layouts/Base.astro";
---

<Base title="Search" noindex list>
  <h1 class="sr-only">Search</h1>
  <search id="searchbox">
    <input id="searchInput" autofocus placeholder="Search any posts" aria-label="Search posts" type="search" autocomplete="off" />
    <ul id="searchResults" aria-label="Search results" aria-live="polite"></ul>
  </search>
</Base>

<script>
  type Item = { title: string; url: string; text: string };

  const input = document.getElementById("searchInput") as HTMLInputElement;
  const results = document.getElementById("searchResults")!;
  const items: Item[] = await (await fetch("/index.json")).json();

  // Every word of the query must appear in the post; title matches come first.
  const find = (words: string[]) => {
    const has = (s: string) => words.every((w) => s.toLowerCase().includes(w));
    return items.filter((i) => has(`${i.title} ${i.text}`)).sort((a, b) => +has(b.title) - +has(a.title));
  };

  const item = (text: string, url?: string) => {
    const li = document.createElement("li");
    li.append(Object.assign(document.createElement("header"), { textContent: text }));
    if (url) li.append(Object.assign(document.createElement("a"), { href: url, ariaLabel: text }));
    else li.className = "empty";
    return li;
  };

  const search = () => {
    const query = input.value.trim();
    const words = query.toLowerCase().split(/\s+/).filter(Boolean);
    const found = words.length ? find(words) : [];
    results.replaceChildren(
      ...(words.length && !found.length ? [item(`No posts match “${query}”`)] : found.map((p) => item(`${p.title} »`, p.url))),
    );
    // Keep the query in the URL so searches can be shared and survive reloads.
    history.replaceState(null, "", query ? `?q=${encodeURIComponent(query)}` : location.pathname);
  };

  input.value = new URLSearchParams(location.search).get("q") ?? "";
  input.addEventListener("input", search);
  search();
</script>

<style>
  input {
    width: 100%;
    padding: 4px 10px;
    color: var(--primary);
    font-weight: bold;
    border: 2px solid var(--tertiary);
    border-radius: var(--radius);

    &:focus {
      border-color: var(--secondary);
    }
  }

  #searchResults {
    width: 100%;
    margin: 10px 0;
  }

  /* Result items are created by the script, so they need :global() */
  #searchResults :global(li) {
    position: relative;
    display: flex;
    margin: 10px 0;
    padding: 10px;
    list-style: none;
    font-weight: 500;
    background: var(--entry);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.1s;
  }

  #searchResults :global(li:active),
  #searchResults :global(li:has(a:focus-visible)) {
    transform: scale(0.98);
  }

  #searchResults :global(li:has(a:focus-visible)) {
    border: 2px solid var(--tertiary);
  }

  #searchResults :global(li.empty) {
    color: var(--secondary);
  }

  #searchResults :global(a) {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion) {
    #searchResults :global(li:active),
    #searchResults :global(li:has(a:focus-visible)) {
      transform: none;
    }
  }
</style>
