---
import Base from "../../layouts/Base.astro";
import { NOTES } from "../../data/notes";

const title = "Notes";
const description = "Free unit-wise PDF study notes on C programming, web technology, cyber security and management information systems.";
---

<Base title={title} description={description} list>
  <h1>{title}</h1>
  {
    NOTES.map((subject) => (
      <section id={subject.slug}>
        <h2>{subject.title}</h2>
        <p>{subject.description}</p>
        <ul class="units">
          {subject.units.map((unit) => (
            <li>
              <a href={unit.file} aria-label={`${unit.label} PDF: ${subject.title}`}>
                {unit.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  h1 {
    margin-bottom: var(--content-gap);
    font-size: 1.5rem;
  }

  section {
    margin-bottom: 36px;
    padding: var(--gap);
    background: var(--entry);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  h2 {
    margin-bottom: 6px;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }

  section p {
    margin-bottom: 14px;
    color: var(--secondary);
    font-size: 14px;
  }

  .units {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 8px;
    list-style: none;
  }

  .units a {
    display: block;
    padding: 6px 10px;
    font-size: 14px;
    text-align: center;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);

    &:hover {
      background: var(--border);
    }

    &:active {
      transform: scale(0.96);
    }

    @media (prefers-reduced-motion) {
      &:active {
        transform: none;
      }
    }
  }
</style>
