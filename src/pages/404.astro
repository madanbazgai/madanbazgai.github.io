---
import Base from "../layouts/Base.astro";
---

<Base title="404 Page not found" noindex list>
  <div class="not-found">
    <h1>404</h1>
    <p>This page doesn't exist or has moved.</p>
    <p><a href="/">Home</a> · <a href="/blog/">Blog</a> · <a href="/search/">Search</a></p>
  </div>
</Base>

<style>
  .not-found {
    position: absolute;
    inset-inline: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 80%;
    font-size: 160px;
    font-weight: 700;
    text-align: center;

    h1 {
      font-size: inherit;
    }

    p {
      font-size: 18px;
      font-weight: normal;
    }

    a {
      box-shadow: 0 1px 0;
    }
  }
</style>
