---
import { render } from "astro:content";
import Toc from "../../components/Toc.astro";
import { SECTIONS } from "../../config";
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts, postUrl, slugify, stats, type Post } from "../../lib/posts";
import { socialImage } from "../../lib/social-image";
import { postSchema } from "../../lib/structured-data";

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { section: post.collection, slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content, headings } = await render(post);
const { title, description, date, tags, cover } = post.data;
const image = await socialImage(cover?.image);

// Prev/next links only exist between blog posts.
const blog = await getPosts("blog");
const index = blog.findIndex((p) => p.collection === post.collection && p.id === post.id);
const [prev, next] = index >= 0 ? [blog[index - 1], blog[index + 1]] : [];
---

<Base
  title={title}
  description={description}
  image={image}
  article={{ published: date, tags }}
  jsonLd={postSchema(post, Astro.site!, image)}
>
  <article class="post-single">
    <header class="post-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href={`/${post.collection}/`}>{SECTIONS[post.collection].title}</a></li>
        </ol>
      </nav>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {post.collection === "blog" && ` · ${stats(post).minutes} min read`}
      </div>
    </header>
    <Toc headings={headings} />
    <div class="post-content"><Content /></div>
    <footer class="post-footer">
      <ul class="post-tags">
        {tags.map((tag) => <li><a href={`/tags/${slugify(tag)}/`}>{tag}</a></li>)}
      </ul>
      {
        (prev || next) && (
          <nav class="paginav">
            {prev && (
              <a class="prev" href={postUrl(prev)}>
                <span class="title">« Prev</span>
                <br />
                <span>{prev.data.title}</span>
              </a>
            )}
            {next && (
              <a class="next" href={postUrl(next)}>
                <span class="title">Next »</span>
                <br />
                <span>{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>
</Base>

<style>
  .post-single {
    font-family: sans-serif;
  }

  .post-header {
    margin: 0 auto var(--content-gap);
  }

  .breadcrumbs,
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    color: var(--secondary);
    font-size: 14px;
  }

  .breadcrumbs {
    ol {
      display: flex;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    li + li::before {
      content: "\00a0»\00a0";
    }

    a {
      font-size: 16px;
    }
  }

  .post-title {
    margin-bottom: 15px;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .post-footer {
    margin-top: 56px;
  }

  .post-tags li {
    display: inline-block;
    margin-inline-end: 3px;
    margin-bottom: 5px;
  }

  .post-tags a,
  .paginav {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .post-tags a {
    display: block;
    padding-inline: 14px;
    color: var(--secondary);
    font-size: 14px;
    line-height: 34px;
  }

  .post-tags a:hover,
  .paginav a:hover {
    background: var(--border);
  }

  .paginav {
    display: flex;
    margin: 10px 0;
    line-height: 30px;

    a {
      width: 50%;
      padding-inline: 14px;
      border-radius: var(--radius);
    }

    .next {
      margin-inline-start: auto;
      text-align: end;
    }

    .title {
      color: var(--secondary);
      font-size: small;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    span:hover:not(.title) {
      box-shadow: 0 1px 0;
    }
  }
</style>

<script>
  // "#" link shown when hovering a heading.
  for (const heading of document.querySelectorAll(".post-content :is(h1, h2, h3, h4, h5, h6)[id]")) {
    const anchor = Object.assign(document.createElement("a"), { className: "anchor", href: `#${heading.id}`, hidden: true });
    anchor.ariaHidden = "true";
    anchor.textContent = "#";
    heading.append(anchor);
  }

  // Copy button on code blocks.
  for (const code of document.querySelectorAll<HTMLElement>(".post-content pre > code")) {
    const button = Object.assign(document.createElement("button"), { className: "copy-code", textContent: "copy" });
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(code.textContent ?? "");
      button.textContent = "copied!";
      setTimeout(() => (button.textContent = "copy"), 2000);
    });
    code.parentElement!.append(button);
  }
</script>
