---
import { Image } from "astro:assets";
import profile from "../assets/madmax.jpg";
import SocialIcons from "../components/SocialIcons.astro";
import { SITE } from "../config";
import Base from "../layouts/Base.astro";
import { formatShortDate, getPosts, postUrl } from "../lib/posts";
import { homeSchema } from "../lib/schema";

const pinned = (await getPosts()).filter((post) => post.data.pinned);
---

<Base jsonLd={homeSchema(Astro.site!)} list>
  <div class="profile">
    <div class="profile_inner">
      <Image src={profile} alt="Madan Bazgai" width={360} loading="eager" fetchpriority="high" draggable="false" />
      <h1>{SITE.title}</h1>
      <span>{SITE.subtitle}</span>
      <SocialIcons />
      <div class="buttons">
        <a class="button" href="/blog/" title="Blog"><span class="button-inner">Blog</span></a>
        <a class="button" href={SITE.github} title="Github">
          <span class="button-inner">
            Github&nbsp;
            <svg class="github-icon" viewBox="0 0 24 24" fill="none" height="20" width="20" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
    <div class="pinned-article">
      <p>Pinned Articles</p>
      <ul>
        {
          pinned.map((post) => (
            <li>
              <a href={postUrl(post)}>{post.data.title}</a> &ndash;{" "}
              <time datetime={post.data.date.toISOString()}>{formatShortDate(post.data.date)}</time>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(90vh - var(--header-height) - var(--footer-height) - var(--gap) * 2);
    text-align: center;

    @media (max-width: 600px) {
      padding-top: 4rem;
    }

    @media (min-width: 769px) {
      min-height: calc(100vh - var(--header-height) - var(--footer-height) - var(--gap) * 2);
      margin-top: 80px;
    }

    :global(img) {
      display: inline-table;
      width: 180px;
      height: 180px;
      margin-bottom: 25px;
      border-radius: 50%;
      box-shadow: 5px 11px 58px 7px #33333396;

      @media (max-width: 768px) {
        transform: scale(0.85);
      }
    }

    h1 {
      padding: 12px 0;
      font-weight: bold;
    }
  }

  :global(.dark) .profile :global(img) {
    box-shadow: 0 0 134px 19px #000000;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 400px;
    margin: 0 auto;
  }

  .button {
    margin: 8px;
    padding: 6px;
    background: var(--tertiary);
    border-radius: var(--radius);
    transition: transform 0.1s;
    animation: glowing 4000ms infinite;

    &:active {
      transform: scale(0.96);
    }

    @media (prefers-reduced-motion: reduce) {
      animation: none;
      background-color: #1b7001;

      &:active {
        transform: none;
      }
    }
  }

  @keyframes glowing {
    0% {
      background-color: #1b7001;
      box-shadow: 0 0 3px hsl(106, 94%, 37%);
    }
    50% {
      background-color: #268010;
      box-shadow: 0 0 10px #3aca0e;
    }
    100% {
      background-color: #1a6e00;
      box-shadow: 0 0 3px hsl(106, 94%, 37%);
    }
  }

  .button-inner {
    padding: 0 8px;
    color: white;
  }

  .github-icon {
    display: inline;
    padding-top: 6px;
  }

  .pinned-article {
    width: 400px;
    margin-top: 30px;
    text-align: left;
    font-size: 1rem;

    a {
      border-bottom: 1px solid rgb(94, 231, 30);
    }

    time {
      font-size: 0.7rem;
    }

    @media (max-width: 600px) {
      width: 300px;
      font-size: 0.9rem;

      time {
        font-size: 0.75rem;
      }
    }
  }
</style>
