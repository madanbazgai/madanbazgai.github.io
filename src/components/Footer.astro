---
import { SITE } from "../config";
import ArrowUp from "../icons/arrow-up.svg";
---

<footer class="footer">
  <span>&copy; {new Date().getFullYear()}</span>
  <span>
    Designed & Developed by{" "}
    <a href={SITE.github} rel="noreferrer" target="_blank">MadanBazgai</a>
  </span>
</footer>
<a href="#top" aria-label="Go to top" title="Go to top" class="top-link">
  <ArrowUp />
</a>


<style>
  .footer,
  .top-link {
    font-size: 12px;
    color: var(--secondary);
  }

  .footer {
    max-width: calc(var(--main-width) + var(--gap) * 2);
    margin: auto;
    padding: calc((var(--footer-height) - var(--gap)) / 2) var(--gap);
    text-align: center;
    line-height: 24px;

    span {
      margin-inline: 1px;

      &:last-child {
        white-space: nowrap;
      }
    }

    a {
      color: inherit;
      border-bottom: 1px solid var(--secondary);

      &:hover {
        color: var(--primary);
        border-bottom-color: var(--primary);
      }
    }

    @media (max-width: 768px) {
      padding: calc((var(--footer-height) - var(--gap) - 10px) / 2) var(--gap);
    }
  }

  /* Fades in after scrolling 700–800px, driven by CSS alone. */
  .top-link {
    visibility: hidden;
    opacity: 0;
    position: fixed;
    bottom: 60px;
    right: 30px;
    z-index: 99;
    width: 42px;
    height: 42px;
    padding: 12px;
    background: var(--tertiary);
    border-radius: 64px;
    /* Without scroll-driven animation support this runs instantly, leaving the button visible. */
    animation: reveal linear both;

    :global(svg) {
      display: block;
    }

    &:hover {
      color: var(--primary);
    }
  }

  @media (max-width: 900px) {
    :global(.list) .top-link {
      transform: translateY(-5rem);
    }
  }

  /* Kept in its own rule so the minifier can't fold it into the animation shorthand. */
  @supports (animation-timeline: scroll()) {
    .top-link {
      animation-timeline: scroll(root);
      animation-range: 700px 800px;
    }
  }

  @keyframes reveal {
    to {
      visibility: visible;
      opacity: 1;
    }
  }
</style>
