---
import { SITE } from "../config";
---

<footer class="footer">
  <span>&copy; {new Date().getFullYear()}</span>
  <span>
    Designed & Developed by{" "}
    <a href={SITE.github} rel="noreferrer" target="_blank">MadanBazgai</a>
  </span>
</footer>
<a href="#top" aria-label="go to top" title="Go to Top (Alt + G)" class="top-link" id="top-link" accesskey="g">
  <svg viewBox="0 0 12 6" fill="currentColor"><path d="M12 6H0l6-6z"></path></svg>
</a>

<script>
  const topLink = document.getElementById("top-link")!;
  const toggleTopLink = () => {
    const show = scrollY > 800;
    topLink.style.visibility = show ? "visible" : "hidden";
    topLink.style.opacity = show ? "1" : "0";
  };
  addEventListener("scroll", toggleTopLink, { passive: true });
</script>

<style>
  .footer,
  .top-link {
    font-size: 12px;
    color: var(--secondary);
  }

  .footer {
    max-width: calc(var(--main-width) + var(--gap) * 2);
    margin: auto;
    padding: calc((var(--footer-height) - var(--gap)) / 2) var(--gap);
    text-align: center;
    line-height: 24px;

    span {
      margin-inline: 1px;

      &:last-child {
        white-space: nowrap;
      }
    }

    a {
      color: inherit;
      border-bottom: 1px solid var(--secondary);

      &:hover {
        color: var(--primary);
        border-bottom-color: var(--primary);
      }
    }

    @media (max-width: 768px) {
      padding: calc((var(--footer-height) - var(--gap) - 10px) / 2) var(--gap);
    }
  }

  .top-link {
    visibility: hidden;
    position: fixed;
    bottom: 60px;
    right: 30px;
    z-index: 99;
    width: 42px;
    height: 42px;
    padding: 12px;
    background: var(--tertiary);
    border-radius: 64px;
    transition:
      visibility 0.5s,
      opacity 0.8s linear;

    &:hover {
      color: var(--primary);
    }
  }

  @media (max-width: 900px) {
    :global(.list) .top-link {
      transform: translateY(-5rem);
    }
  }
</style>
