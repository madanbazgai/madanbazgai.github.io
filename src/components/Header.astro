---
import { MENU, SITE } from "../config";
import Moon from "../icons/moon.svg";
import SearchIcon from "../icons/search.svg";
import Sun from "../icons/sun.svg";

const path = Astro.url.pathname;
// A section stays highlighted on its posts too, e.g. "Blog" on /blog/some-post/.
const isActive = (url: string) => url.startsWith("/") && path.startsWith(url);
---

<header class="header">
  <nav class="nav">
    <div class="logo">
      <a href="/" title={SITE.title}>{SITE.title}</a>
    </div>
    <ul id="menu">
      {
        MENU.map(({ name, url }) => (
          <li>
            <a href={url} title={name}>
              <span class:list={{ active: isActive(url) }}>{name}{url.startsWith("http") && " ↗"}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/search/" title="Search" aria-label="Search">
          <span class:list={{ active: path === "/search/" }}>
            <SearchIcon class="search-icon" width="25" height="25" />
          </span>
        </a>
      </li>
      <li>
        <button id="theme-toggle" title="Toggle dark mode" aria-label="Dark mode" aria-pressed="false">
          <Moon id="moon" width="26" height="26" />
          <Sun id="sun" width="26" height="26" />
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("theme-toggle")!;
  const sync = () => toggle.setAttribute("aria-pressed", String(document.body.classList.contains("dark")));
  sync();
  toggle.addEventListener("click", () => {
    const dark = document.body.classList.toggle("dark");
    localStorage.setItem("pref-theme", dark ? "dark" : "light");
    sync();
  });
</script>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    max-width: calc(var(--nav-width) + var(--gap) * 2);
    margin-inline: auto;
    line-height: var(--header-height);

    a {
      display: block;
    }
  }

  .logo,
  #menu {
    display: flex;
    align-items: center;
    margin: auto var(--gap);
  }

  .logo {
    flex-wrap: inherit;

    a {
      font-size: 16px;
      font-weight: 700;
    }
  }

  #menu {
    list-style: none;
    word-break: keep-all;
    white-space: nowrap;

    li + li {
      margin-inline-start: var(--gap);
    }

    a {
      font-size: 16px;
    }

    .active {
      font-weight: 700;
      border-bottom: 2px solid currentColor;
    }
  }

  #menu :global(.search-icon) {
    margin-top: 18px;
  }

  #theme-toggle {
    font-size: 40px;
    margin: auto 15px;
  }

  :global(body.dark #moon),
  :global(body:not(.dark) #sun) {
    display: none;
  }

  @media (max-width: 600px) {
    .nav {
      justify-content: center;
      line-height: 1;
    }

    .logo {
      padding: 20px;
    }

    #menu {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 12px;

      li + li {
        margin-inline-start: 12px;
      }

      /* 24px tap targets without changing the layout */
      a {
        padding-block: 4px;
        margin-block: -4px;
      }
    }

    #menu :global(.search-icon) {
      margin-top: 0;
    }

    #theme-toggle {
      font-size: 0;
      margin: 0;
    }
  }
</style>
