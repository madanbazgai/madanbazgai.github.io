---
import { Image } from "astro:assets";
import { formatDate, postUrl, stats, type Post } from "../lib/posts";

interface Props {
  post: Post;
  tagEntry?: boolean;
}

const { post, tagEntry = false } = Astro.props;
const { title, date, description, cover } = post.data;
---

<article class:list={["post-entry", { "tag-entry": tagEntry }]}>
  {
    cover && (
      <figure class="entry-cover">
        {typeof cover.image === "string" ? (
          <img loading="lazy" src={cover.image} alt={cover.alt} width="400" height="210" />
        ) : (
          <Image src={cover.image} alt={cover.alt} width={400} />
        )}
      </figure>
    )
  }
  <div class="article-content">
    <header class="entry-header"><h2>{title}</h2></header>
    <div class="entry-content"><p>{description}</p></div>
    <footer class="entry-footer">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {post.collection === "blog" && ` · ${stats(post).minutes} min read`}
    </footer>
  </div>
  <a class="entry-link" aria-label={`post link to ${title}`} href={postUrl(post)}></a>
</article>
