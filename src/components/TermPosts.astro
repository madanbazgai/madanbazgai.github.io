---
import Base from "../layouts/Base.astro";
import type { Post } from "../lib/posts";
import PostEntry from "./PostEntry.astro";

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<Base title={name} noindex list>
  <h1 class="sr-only">{name}</h1>
  {posts.map((post) => <PostEntry post={post} tagEntry />)}
</Base>
