---
import Email from "../icons/email.svg";
import Facebook from "../icons/facebook.svg";
import Instagram from "../icons/instagram.svg";
import Linkedin from "../icons/linkedin.svg";
import Phone from "../icons/phone.svg";
import Twitter from "../icons/twitter.svg";
import Whatsapp from "../icons/whatsapp.svg";

const links = [
  { title: "Phone", url: "tel:9779804516288", Icon: Phone },
  { title: "Email", url: "mailto:madanbajgai@gmail.com", Icon: Email },
  { title: "Whatsapp", url: "https://wa.me/9779804516288", Icon: Whatsapp },
  { title: "Twitter", url: "https://x.com/dr__madmax", Icon: Twitter },
  { title: "Instagram", url: "https://www.instagram.com/madanbazgai/", Icon: Instagram },
  { title: "Facebook", url: "https://www.facebook.com/madanbazgai3", Icon: Facebook },
  { title: "Linkedin", url: "https://www.linkedin.com/in/madanbazgai/", Icon: Linkedin },
];
---

<div class="social-icons">
  {
    links.map(({ title, url, Icon }) => (
      <a href={url} title={title} aria-label={title} {...(url.startsWith("http") && { target: "_blank", rel: "noreferrer me" })}>
        <Icon width="26" height="26" />
      </a>
    ))
  }
</div>

<style>
  .social-icons {
    padding: 12px 0;

    a {
      display: inline-flex;
      vertical-align: middle;
    }

    a:not(:last-of-type) {
      margin-inline-end: 12px;
    }

    :global(svg) {
      width: 26px;
      height: 26px;
    }
  }
</style>
