---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Indent each entry by its depth relative to the shallowest heading.
const top = Math.min(...headings.map((h) => h.depth));
---

{
  headings.length > 0 && (
    <nav class="toc" aria-label="Table of contents">
      <details>
        <summary>
          <span class="details">Table of Contents</span>
        </summary>
        <ul class="inner">
          {headings.map(({ depth, slug, text }) => (
            <li style={`--level: ${depth - top}`}>
              <a href={`#${slug}`}>{text}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

<style>
  .toc {
    margin: 0 2px 40px 2px;
    padding: 0.4em;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  :global(.dark) .toc {
    background: var(--entry);
  }

  summary {
    cursor: zoom-in;
    margin-inline-start: 20px;
  }

  details[open] > summary {
    cursor: zoom-out;
  }

  .details {
    display: inline;
    font-weight: 500;
  }

  .inner {
    margin: 0 20px;
    padding: 10px 20px;
  }

  li {
    margin-inline-start: calc(var(--level) * var(--gap));
  }

  a:hover {
    box-shadow: 0 1px 0;
  }

  /* Smoothly expand/collapse where supported */
  @media (prefers-reduced-motion: no-preference) {
    details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.25s,
        content-visibility 0.25s allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
    }
  }
</style>
