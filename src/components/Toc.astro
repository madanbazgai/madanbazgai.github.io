---
import type { MarkdownHeading } from "astro";

type Node = { heading: MarkdownHeading; children: Node[] };
type Props = { headings: MarkdownHeading[] } | { nodes: Node[] };

// Nest headings by depth: each heading becomes a child of the closest shallower one.
const toTree = (headings: MarkdownHeading[]) => {
  const root: Node[] = [];
  const stack: Node[] = [];
  for (const heading of headings) {
    const node: Node = { heading, children: [] };
    while (stack.length && stack.at(-1)!.heading.depth >= heading.depth) stack.pop();
    (stack.at(-1)?.children ?? root).push(node);
    stack.push(node);
  }
  return root;
};

const props = Astro.props;
---

{
  "nodes" in props ? (
    <ul>
      {props.nodes.map(({ heading, children }) => (
        <li>
          <a href={`#${heading.slug}`} aria-label={heading.text}>
            {heading.text}
          </a>
          {children.length > 0 && <Astro.self nodes={children} />}
        </li>
      ))}
    </ul>
  ) : (
    props.headings.length > 0 && (
      <div class="toc">
        <details>
          <summary accesskey="c" title="(Alt + C)">
            <span class="details">Table of Contents</span>
          </summary>
          <div class="inner">
            <Astro.self nodes={toTree(props.headings)} />
          </div>
        </details>
      </div>
    )
  )
}

<style>
  .toc {
    margin: 0 2px 40px 2px;
    padding: 0.4em;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  :global(.dark) .toc {
    background: var(--entry);
  }

  summary {
    cursor: zoom-in;
    margin-inline-start: 20px;
  }

  details[open] > summary {
    cursor: zoom-out;
  }

  .details {
    display: inline;
    font-weight: 500;
  }

  .inner {
    margin: 0 20px;
    padding: 10px 20px;
  }

  li ul {
    margin-inline-start: var(--gap);
  }

  a:hover {
    box-shadow: 0 1px 0;
  }

  /* Smoothly expand/collapse where supported */
  @media (prefers-reduced-motion: no-preference) {
    details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.25s,
        content-visibility 0.25s allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
    }
  }
</style>
